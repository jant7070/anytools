# --- Server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# --- Data stores (docker-compose.yml) ---
DATABASE_URL=postgres://anytools:anytools@localhost:5442/anytools
REDIS_URL=redis://localhost:6390

# --- Secrets (development values only; generate new ones for production: `openssl rand -base64 48`) ---
COOKIE_SECRET=dev-cookie-secret-change-me-0123456789abcdef
UNLOCK_JWT_SECRET=dev-unlock-jwt-secret-change-me-0123456789
IP_HASH_SALT=dev-ip-hash-salt-change-me
FILE_SIGNING_SECRET=dev-file-signing-secret-change-me-0123456789

# Secure cookies default to true when NODE_ENV=production.
# COOKIE_SECURE=false

# --- Proxy / Cloudflare ---
# Proxy hops to trust for X-Forwarded-For: false | <hop count> | <comma-separated IPs/CIDRs>.
# Production behind Traefik: 1. Avoid `true` (it trusts spoofed headers).
TRUST_PROXY=false
# Read the client IP/country from CF-Connecting-IP / CF-IPCountry. Enable ONLY when the origin
# accepts traffic exclusively from Cloudflare (firewall or Authenticated Origin Pulls).
TRUST_CLOUDFLARE_HEADERS=false

# Show `draft` tools in the catalog (defaults to true in development).
# SHOW_DRAFT_TOOLS=true

# --- Cloudflare Turnstile (official test secret: always passes) ---
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Ads: dev | monetag | applixir ---
AD_PROVIDER=dev
DEV_AD_SECONDS=5
# MONETAG_ZONE_ID=
# MONETAG_SDK_URL=        # copy the SDK script URL from the Monetag dashboard
# MONETAG_MIN_SECONDS=20
# APPLIXIR_API_KEY=
# APPLIXIR_GAME_ID=
# APPLIXIR_SECRET=
# APPLIXIR_SDK_URL=https://cdn.applixir.com/applixir.app.v6.1.0.js

# --- Rate limits ---
# Unlock sessions per IP per UTC day (soft cap; time-based providers cannot prove an ad was shown).
UNLOCK_MAX_PER_IP_PER_DAY=300
# Per minute:
UNLOCK_RUNS_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_UNLOCK_START_PER_MINUTE=10
RATE_LIMIT_RUN_PER_MINUTE=30
RATE_LIMIT_EVENTS_PER_MINUTE=60

# --- File storage: local | s3 (Cloudflare R2) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../.storage
# S3_BUCKET=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
