# Read at request time by the Next.js server (no NEXT_PUBLIC_ build-time inlining), so the same
# Docker image works in every environment.

# Canonical public URL, used for canonical/hreflang links, sitemap.xml and robots.txt.
SITE_URL=http://localhost:3000

# Where Server Components fetch the catalog from (server-to-server, not through the browser).
API_INTERNAL_URL=http://localhost:4000

# Dev only: target of the `/api/*` rewrite (defaults to http://localhost:4000 in development).
# API_PROXY_URL=http://localhost:4000

# Cloudflare Turnstile site key (official test key: always passes).
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional analytics: each one loads only when its key is set.
# POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# CLARITY_PROJECT_ID=
