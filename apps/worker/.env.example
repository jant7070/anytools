NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://anytools:anytools@localhost:5442/anytools
REDIS_URL=redis://localhost:6390

# Parallel tool jobs per worker process.
WORKER_CONCURRENCY=2
# How often expired files and stale unlock sessions are cleaned up.
CLEANUP_EVERY_SECONDS=300
# Tiny HTTP endpoint for container healthchecks (GET /health).
WORKER_HEALTH_PORT=4100

# Must match the API's storage settings (same directory / bucket).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../.storage
FILE_SIGNING_SECRET=dev-file-signing-secret-change-me-0123456789
# S3_BUCKET=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
