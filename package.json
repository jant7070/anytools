{
  "name": "anytools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/setup-env.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @anytools/db db:generate",
    "db:migrate": "pnpm --filter @anytools/db db:migrate",
    "db:seed": "pnpm --filter @anytools/db db:seed",
    "db:studio": "pnpm --filter @anytools/db db:studio",
    "new-tool": "tsx scripts/new-tool.ts"
  },
  "devDependencies": {
    "@anytools/config": "workspace:*",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.11.9",
    "typescript": "catalog:"
  }
}
