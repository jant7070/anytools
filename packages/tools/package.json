{
  "name": "@anytools/tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@anytools/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage": {
      "@anytools/source": "./src/storage/index.ts",
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./schemas/*": {
      "@anytools/source": "./src/*/schema.ts",
      "types": "./dist/*/schema.d.ts",
      "default": "./dist/*/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anytools/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@anytools/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
