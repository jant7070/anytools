{
  "name": "@anytools/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "exports": {
    ".": {
      "@anytools/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "@anytools/source": "./src/migrate.ts",
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./seed": {
      "@anytools/source": "./src/seed.ts",
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anytools/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@anytools/config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
